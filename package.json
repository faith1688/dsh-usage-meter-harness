{
  "name": "@faith1688/dsh-usage-meter-harness",
  "description": "为 DeepSeek Harness 打造的实时用量/费用/余额计量插件：在聊天输入框旁直接看到 tokens、花费与真实余额。",
  "version": "1.0.21",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./projection": {
      "types": "./lib/projection.d.ts",
      "default": "./lib/projection.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "scripts"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "harness",
    "plugin",
    "usage",
    "meter",
    "cost",
    "billing",
    "session-projection"
  ],
  "author": "faith1688",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faith1688/dsh-usage-meter-harness.git"
  },
  "bugs": {
    "url": "https://github.com/faith1688/dsh-usage-meter-harness/issues"
  },
  "homepage": "https://github.com/faith1688/dsh-usage-meter-harness",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.build.json && node build-client.mjs",
    "typecheck": "tsc --noEmit",
    "build:client": "node build-client.mjs",
    "prepack": "npm run bundle"
  },
  "bin": {
    "dsh-usage-meter-install": "scripts/install.mjs"
  }
}
