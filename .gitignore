# build output
# lib/ is committed so the repo is self-contained (npm publish ships it via `files:["lib"]`);
# `npm run bundle` / `prepack` regenerate it from src/.
*.tsbuildinfo

# dependencies
node_modules/
package-lock.json

# packed npm tarball (regenerate with `npm pack`)
*.tgz

# logs
*.log
npm-debug.log*

# internal maintainer manual — local only, never published to the repo or the npm package
/DEVELOPMENT.md

# local dev artifacts (probe/session dumps)
dev/.session-*.jsonl

# editor / OS
.DS_Store
.vscode/
.idea/
